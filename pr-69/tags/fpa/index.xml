    <item>
      <title>New Grant: refactoring Sketcher, part 2</title>
      <link>https://marcuspollio.github.io/FreeCAD-website/pr-69/news/new-grant-refactoring-sketcher-part-2/</link>
      <pubDate>Fri, 31 Jan 2025 00:00:00 +0000</pubDate>
